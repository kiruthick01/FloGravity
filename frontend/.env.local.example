# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Cesium ion access token (cesium.com/ion -> Access Tokens). This is a public,
# client-side token by design (same model as a Mapbox public token) - it powers
# the terrain/imagery streaming in the browser.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Base URL of the FastAPI backend (set once it's deployed; defaults to local dev).
NEXT_PUBLIC_API_URL=http://localhost:8000
